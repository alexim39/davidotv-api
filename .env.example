# DavidoTV API — environment contract (NO secrets here; copy to .env via vault)
# See docs/modernization/00-discovery/risk-register.md CR-01 and integration-register.md

PORT=3000
NODE_ENV=development

# MongoDB Atlas (rotate — never commit values)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=davidotv

# Auth — single contract (SEC-02). Legacy JWTTOKENSECRET deprecated; use JWT_SECRET only
JWT_SECRET=
# JWTTOKENSECRET= # LEGACY — remove after auth cutover

# YouTube (rotate; no hardcoded fallback after SEC-01)
YOUTUBE_API_KEY=
OFFICIAL_CHANNEL_IDS=
# CRON_TRENDING=7 */7 * * *
# CRON_MUSIC=23 0,12 * * *
# CRON_VIDEOS=11 */5 * * *
# CRON_METRICS=37 */3 * * *

# SMTP (new mailer.js). Legacy EMAILPASS-only flow deprecated
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@davidotv.com

# Firebase Admin (optional; push disabled when absent)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloudinary (REQUIRED for all user uploads — talent, avatars, posts, forum).
# Standard URL form: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Without it, uploads fail fast with 503 (no local-disk fallback by design).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=davidotv

# Paystack (rotate; NEVER expose sk_* in frontend)
# Membership billing runs in TEST mode until explicit live cutover:
# set PAYSTACK_SECRET=sk_test_..., verify webhooks, then swap to sk_live.
PAYSTACK_SECRET=
# PAYSTACKTOKEN= # LEGACY name — migrate to PAYSTACK_SECRET then delete
PAYSTACK_WEBHOOK_SECRET=
# Publishable key for Paystack Inline checkout (pk_test_... safe for frontend).
# Request a test public key from the Paystack dashboard (Settings → API Keys).
PAYSTACK_PUBLIC_KEY=

# Public frontend origin (Paystack callback_url + CORS-adjacent)
FRONTEND_URL=http://localhost:4200

# Flags
FEATURE_LEGACY_CRAWLERS=false
FEATURE_AUTH_V2=false
LOG_LEVEL=info
