# DavidoTV API — environment contract (NO secrets here; copy to .env via vault)
# See docs/modernization/00-discovery/risk-register.md CR-01 and integration-register.md

PORT=3000
NODE_ENV=development

# MongoDB Atlas (rotate — never commit values)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=davidotv

# Auth — single contract (SEC-02). Legacy JWTTOKENSECRET deprecated; use JWT_SECRET only
JWT_SECRET=
# JWTTOKENSECRET= # LEGACY — remove after auth cutover

# YouTube (rotate; no hardcoded fallback after SEC-01)
YOUTUBE_API_KEY=
OFFICIAL_CHANNEL_IDS=
# CRON_TRENDING=7 */7 * * *
# CRON_MUSIC=23 0,12 * * *
# CRON_VIDEOS=11 */5 * * *
# CRON_METRICS=37 */3 * * *

# SMTP (new mailer.js). Legacy EMAILPASS-only flow deprecated
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@davidotv.com

# Firebase Admin (optional; push disabled when absent)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Paystack (rotate; NEVER expose sk_* in frontend)
PAYSTACK_SECRET=
# PAYSTACKTOKEN= # LEGACY name — migrate to PAYSTACK_SECRET then delete
PAYSTACK_WEBHOOK_SECRET=

# Flags
FEATURE_LEGACY_CRAWLERS=false
FEATURE_AUTH_V2=false
LOG_LEVEL=info
